# Vercel Cron Secret
# Generate a random string for production: openssl rand -base64 32
CRON_SECRET=your-secret-key-here

# St. Louis Fed (FRED) API — required for /trends/gold numeric data (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
# Copy this file to .env.local and paste your real key there. Next.js does NOT load .env.example at runtime.
FRED_API_KEY=your-fred-api-key-here
