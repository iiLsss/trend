# OpenRouter (LLM via Gemini)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_MODEL=google/gemini-2.0-flash-lite-001
EMBEDDING_MODEL=google/gemini-embedding-exp

# Supabase (shared database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CLI (not env vars — run from apps/agent after: source .venv/bin/activate && export $(cat .env | xargs))
#   python3 -m src.main --once --limit 30
#   python3 -m src.main --resume-from-db --limit 30
#   python3 -m src.main --resume-from-db --limit 30 --skip-embedding   # no embedding API cost
